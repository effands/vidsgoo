{
  "manifest_version": 3,
  "name": "VIDS GOO · AI Video Automation Helper",
  "version": "2.5",
  "description": "Ekstensi Chrome VIDS GOO untuk otomatisasi generate video Google Vids, atur ratio, dan download video.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "alarms",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://docs.google.com/videos/*",
    "https://contribution-rt.usercontent.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/videos/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
